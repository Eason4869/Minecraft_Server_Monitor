{
  "target_group": {
    "description": "旧版通知QQ群（兼容迁移）",
    "type": "string",
    "hint": "推荐留空并使用 group_entries。仅能唯一确定一个 OneBot 平台时自动迁移旧配置。",
    "default": ""
  },
  "check_interval": {
    "description": "全局默认检测间隔（秒）",
    "type": "int",
    "hint": "当某台服务器未单独填写检测间隔时，使用这里的值。建议 30-60 秒。",
    "default": 45
  },
  "enable_auto_monitor": {
    "description": "插件加载后自动启动监控",
    "type": "bool",
    "default": true
  },
  "mcbbs_api": {
    "description": "使用 MineBBS API 作为默认查询源",
    "type": "bool",
    "hint": "默认开启。开启时使用 https://motd.minebbs.com/api/status；关闭后切换为 mcstatus.io。",
    "default": true
  },
  "display_options": {
    "description": "消息展示项开关",
    "type": "object",
    "hint": "控制手动查询和自动通知中显示哪些栏目。",
    "items": {
      "show_server_name": {
        "description": "展示服务器名称",
        "type": "bool",
        "default": true
      },
      "show_server_address": {
        "description": "展示服务器地址",
        "type": "bool",
        "default": false
      },
      "show_server_type": {
        "description": "展示服务器类型",
        "type": "bool",
        "default": true
      },
      "show_game_version": {
        "description": "展示游戏版本",
        "type": "bool",
        "default": false
      },
      "show_online_players": {
        "description": "展示在线玩家数量",
        "type": "bool",
        "default": true
      },
      "show_motd": {
        "description": "展示 MOTD",
        "type": "bool",
        "default": true
      },
      "show_player_list": {
        "description": "展示当前在线玩家列表",
        "type": "bool",
        "default": false
      },
      "show_update_time": {
        "description": "展示更新时间",
        "type": "bool",
        "default": true
      },
      "show_hitokoto": {
        "description": "展示一言",
        "type": "bool",
        "default": false
      }
    },
    "default": {
      "show_server_name": true,
      "show_server_address": false,
      "show_server_type": true,
      "show_game_version": false,
      "show_online_players": true,
      "show_motd": true,
      "show_player_list": false,
      "show_update_time": true,
      "show_hitokoto": false
    }
  },
  "server_entries": {
    "description": "多服务器配置列表",
    "type": "template_list",
    "hint": "每一项是一台服务器。消息通知和查询结果会优先使用你填写的 server_name。",
    "templates": {
      "minecraft_server": {
        "name": "服务器配置项",
        "hint": "添加一台需要监控的 Minecraft 服务器。",
        "items": {
          "key": {
            "description": "服务器唯一标识",
            "type": "string",
            "hint": "建议填写英文字母、数字或下划线，例如 survival_main。",
            "default": ""
          },
          "enabled": {
            "description": "启用该服务器监控",
            "type": "bool",
            "default": true
          },
          "server_name": {
            "description": "服务器名称",
            "type": "string",
            "hint": "建议填写你希望在通知消息里展示的名称；留空时会优先回退到 key。",
            "default": ""
          },
          "server_ip": {
            "description": "服务器地址",
            "type": "string",
            "hint": "支持域名或 IP，例如 play.example.com。",
            "default": ""
          },
          "server_port": {
            "description": "服务器端口",
            "type": "int",
            "default": 25565,
            "hint": "Java 常用 25565；选择 Bedrock 时请填写实际端口（常用 19132）。"
          },
          "server_type": {
            "description": "服务器类型",
            "type": "string",
            "hint": "填写 java 或 bedrock。",
            "default": "java",
            "options": [
              "java",
              "bedrock"
            ]
          },
          "check_interval": {
            "description": "单服务器检测间隔（秒）",
            "type": "int",
            "hint": "填 0 或负数时将自动回退到全局默认值。",
            "default": 0
          }
        }
      }
    },
    "default": []
  },
  "enable_api_fallback": {
    "description": "查询源失败时尝试备用源",
    "type": "bool",
    "default": true,
    "hint": "仅在 HTTP、网络或解析错误时切换；有效的离线结果不切换。"
  },
  "group_entries": {
    "description": "分群服务器订阅",
    "type": "template_list",
    "default": [],
    "hint": "每个完整 UMO 对应一个群会话。管理员在群内 /mc 本群 获取 UMO，或直接 /mc 订阅 key 自动保存。",
    "templates": {
      "group_subscription": {
        "name": "群订阅",
        "items": {
          "session": {
            "description": "群会话 UMO",
            "type": "string",
            "default": "",
            "hint": "完整填写平台实例ID:GroupMessage:群ID；不要只填群号。"
          },
          "server_keys": {
            "description": "本群可查询和订阅的服务器 key",
            "type": "list",
            "default": [],
            "hint": "必须与 server_entries 中的 key 一致；已禁用服务器保留绑定但不查询。空列表表示未授权任何服务器。"
          },
          "default_server": {
            "description": "默认查询服务器 key",
            "type": "string",
            "default": "",
            "hint": "留空查询本群所有订阅；填写时必须在 server_keys 中。"
          },
          "query_style": {
            "description": "查询展示样式",
            "type": "string",
            "options": [
              "image",
              "text"
            ],
            "default": "image"
          },
          "notification_style": {
            "description": "通知展示样式",
            "type": "string",
            "options": [
              "text",
              "image"
            ],
            "default": "text"
          },
          "notify_mode": {
            "description": "通知类型",
            "type": "string",
            "options": [
              "all",
              "status",
              "off"
            ],
            "default": "all",
            "hint": "all 包含人数与样本变化；status 仅上下线及查询异常恢复；off 关闭通知但保留查询。"
          }
        }
      }
    }
  }
}
